rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() { 
      return request.auth != null && request.auth.token != null; 
    }
    
    function isAdmin() {
      return isSignedIn() && 
             'email' in request.auth.token && 
             request.auth.token.email is string &&
             (
               request.auth.token.email.lower() == "chapceligg@gmail.com" || 
               exists(/databases/$(database)/documents/admins/$(request.auth.token.email.lower()))
             );
    }

    match /movies/{movieId} {
      // Lectura pública para visualización instantánea y catálogo
      allow read: if true;
      // Modificaciones y escrituras exclusivas para administradores
      allow write: if isAdmin();
    }

    match /admins/{adminId} {
      // Un usuario autenticado puede leer su propio registro para saber si es admin, o un admin puede leer la lista
      allow read: if isSignedIn() && (
        ('email' in request.auth.token && request.auth.token.email.lower() == adminId.lower()) || 
        isAdmin()
      );
      // Solo admins pueden agregar o remover permisos
      allow write: if isAdmin();
    }

    // Ruta de verificación de conectividad de la plataforma
    match /test/{testId} {
      allow read: if true;
    }
  }
}
