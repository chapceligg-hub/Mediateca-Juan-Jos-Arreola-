rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() { 
      return request.auth != null && request.auth.token != null; 
    }
    
    function isAdmin() {
      return isSignedIn() && 
             'email' in request.auth.token && 
             request.auth.token.email is string &&
             (
               request.auth.token.email.lower() == "chapceligg@gmail.com" || 
               exists(/databases/$(database)/documents/admins/$(request.auth.token.email.lower()))
             );
    }

    match /movies/{movieId} {
      // Lectura y sincronización global entre equipos incluso en modo bypass sin autenticación de Google
      allow read, write: if true;
    }

    match /admins/{adminId} {
      // Verificación de acceso y sincronización de administradores y editores entre dispositivos
      allow read, write: if true;
    }

    // Ruta de verificación de conectividad de la plataforma
    match /test/{testId} {
      allow read: if true;
    }
  }
}
