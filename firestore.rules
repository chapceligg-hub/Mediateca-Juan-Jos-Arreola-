rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() { return request.auth != null; }
    
    function isAdmin() {
      let email = request.auth.token.email;
      let emailVerified = !('email_verified' in request.auth.token) || request.auth.token.email_verified == true || request.auth.token.email_verified == null;
      return isSignedIn() && emailVerified && 
             (email.lower() == "chapceligg@gmail.com" || 
              exists(/databases/$(database)/documents/admins/$(email.lower())));
    }

    match /movies/{movieId} {
      // Anyone can read
      allow read: if true;
      // Only admins can write
      allow write: if isAdmin();
    }

    match /admins/{adminId} {
      // Allow any signed-in user to read their own definition, or an admin to read any
      allow read: if isSignedIn() && (request.auth.token.email.lower() == adminId.lower() || isAdmin());
      // Only admins can write
      allow write: if isAdmin();
    }
  }
}
