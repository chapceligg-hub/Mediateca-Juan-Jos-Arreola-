rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    match /movies/{movieId} {
      // Lectura y sincronización global del catálogo de películas
      allow read, write: if true;
    }

    // Ruta de verificación de conectividad de la plataforma
    match /test/{testId} {
      allow read: if true;
    }
  }
}
