# Por un error del sistema, la variable GEMINI_API_KEY se ha quedado bloqueada.
# Por favor, PEGA AQUÍ TU LLAVE VERDADERA de Google AI Studio (suele empezar con "AIza..."):
USER_API_KEY=""

# Si la cuota de Gemini se satura en el modo público y buscas una alternativa 100% gratuita con mayor límite,
# puedes obtener una clave gratis en https://openrouter.ai y colocarla aquí.
# Esto activará automáticamente el modelo "Gemini 2.0 Flash Lite Free" bajo otra cuota distinta, salvando tu aplicación.
OPENROUTER_API_KEY=""

# Si prefieres usar la API nativa de Groq por su velocidad extrema (LPU), puedes colocar tu key aquí.
# Alternativamente, si pegas una key que comience con "gsk_" en USER_API_KEY, el sistema la auto-detectará.
GROQ_API_KEY=""

# Si prefieres usar la API ultra veloz de SambaNova Cloud para correr Llama 3.3 70B, coloca tu key aquí:
SAMBANOVA_API_KEY=""

# Configuración de Supabase (Base de Datos):
VITE_SUPABASE_URL=""
VITE_SUPABASE_ANON_KEY=""


# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"
